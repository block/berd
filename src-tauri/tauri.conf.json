{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Goose",
  "version": "0.1.0",
  "identifier": "com.squareup.goose-internal",
  "build": {
    "beforeDevCommand": {
      "script": "exec ./node_modules/.bin/vite",
      "cwd": "..",
      "wait": false
    },
    "devUrl": "http://localhost:1520",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Goose",
        "width": 800,
        "height": 600,
        "minWidth": 608,
        "minHeight": 600,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false,
        "trafficLightPosition": {
          "x": 14,
          "y": 25
        }
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' asset:",
        "connect-src": "ipc: http://ipc.localhost http://localhost:* ws://localhost:* http://127.0.0.1:* ws://127.0.0.1:* https:",
        "img-src": "'self' asset: http://asset.localhost blob: data: https://models.dev",
        "media-src": "'self' asset: http://asset.localhost blob: data:",
        "style-src": "'self' 'unsafe-inline'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/avatars/media/**/*", "$HOME/**/*", "$TEMP/**/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../distro": "distro"
    },
    "externalBin": ["binaries/goosed"],
    "linux": {
      "deb": {
        "depends": ["libvulkan1"]
      },
      "rpm": {
        "depends": ["vulkan-loader"]
      }
    },
    "macOS": {
      "entitlements": "entitlements.plist",
      "hardenedRuntime": true
    }
  }
}
