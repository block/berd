{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "berd-call hook prompt-submit 2>/dev/null || echo '{}'",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "berd-call hook pre-tool 2>/dev/null || echo '{}'",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "berd-call hook post-tool 2>/dev/null || echo '{}'",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "berd-call hook stop 2>/dev/null || echo '{}'",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "berd-call hook permission-request 2>/dev/null || echo '{}'",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
