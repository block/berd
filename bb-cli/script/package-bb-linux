#!/usr/bin/env bash
set -euo pipefail

DIST_DIR="${DIST_DIR:-dist}"
ARCHS="${BB_LINUX_ARCHS:-amd64 arm64}"
RUST_IMAGE="${BB_LINUX_RUST_IMAGE:-rust:1.88-bookworm}"
DOCKER="${DOCKER:-docker}"
UID_NUM="$(id -u)"
GID_NUM="$(id -g)"

status() {
  printf '>>> %s\n' "$*" >&2
}

usage() {
  cat >&2 <<'USAGE'
usage: script/package-bb-linux [build archive package]

Environment:
  BB_LINUX_ARCHS       Space-separated archs: amd64 arm64. Defaults to both.
  BB_LINUX_RUST_IMAGE  Docker Rust image. Defaults to rust:1.88-bookworm.
  DIST_DIR             Output directory. Defaults to dist.
USAGE
  exit 1
}

docker_platform_for_arch() {
  case "$1" in
    amd64|x86_64) printf 'linux/amd64\n' ;;
    arm64|aarch64) printf 'linux/arm64\n' ;;
    *) printf 'unsupported Linux arch: %s\n' "$1" >&2; exit 1 ;;
  esac
}

normalize_arch() {
  case "$1" in
    amd64|x86_64) printf 'amd64\n' ;;
    arm64|aarch64) printf 'arm64\n' ;;
    *) printf 'unsupported Linux arch: %s\n' "$1" >&2; exit 1 ;;
  esac
}

host_docker_platform() {
  case "$(uname -m)" in
    x86_64|amd64) printf 'linux/amd64\n' ;;
    arm64|aarch64) printf 'linux/arm64\n' ;;
    *) printf 'linux/amd64\n' ;;
  esac
}

require_tool() {
  if ! command -v "$1" >/dev/null 2>&1; then
    printf 'required tool missing: %s\n' "$1" >&2
    exit 1
  fi
}

_build_arch() {
  local arch="$1"
  local platform
  platform="$(docker_platform_for_arch "$arch")"
  local out_dir="$DIST_DIR/linux-$arch"

  status "Building bb for $platform"
  mkdir -p "$DIST_DIR" target
  "$DOCKER" run --rm \
    --platform "$platform" \
    -v "$PWD":/work \
    -w /work \
    -e CARGO_TARGET_DIR="/work/target/linux-$arch" \
    "$RUST_IMAGE" \
    bash -lc "
      set -euo pipefail
      export PATH=/usr/local/cargo/bin:\$PATH
      cargo build --locked --release --bin bb
      rm -rf '$out_dir'
      mkdir -p '$out_dir/bin' '$out_dir/share/bb/completions'
      cp '/work/target/linux-$arch/release/bb' '$out_dir/bin/bb'
      chmod 755 '$out_dir/bin/bb'
      if '$out_dir/bin/bb' completions zsh >'$out_dir/share/bb/completions/_bb' 2>/dev/null; then
        chmod 644 '$out_dir/share/bb/completions/_bb'
      else
        rm -f '$out_dir/share/bb/completions/_bb'
      fi
      chown -R '$UID_NUM:$GID_NUM' '$out_dir' '/work/target/linux-$arch'
    "
}

_build() {
  require_tool "$DOCKER"
  for requested in $ARCHS; do
    local arch
    arch="$(normalize_arch "$requested")"
    _build_arch "$arch"
  done
}

_archive_arch() {
  local arch="$1"
  local out_dir="$DIST_DIR/linux-$arch"
  local base="$DIST_DIR/bb-linux-$arch"
  local tar_file="$base.tar"
  local archive_platform="${BB_LINUX_ARCHIVE_PLATFORM:-$(host_docker_platform)}"

  [[ -x "$out_dir/bin/bb" ]] || {
    printf 'missing built binary: %s\n' "$out_dir/bin/bb" >&2
    exit 1
  }

  rm -f "$tar_file" "$base.tar.zst" "$base.tgz"

  status "Creating $tar_file with GNU tar"
  "$DOCKER" run --rm \
    --platform "$archive_platform" \
    -v "$PWD":/work \
    -w /work \
    "$RUST_IMAGE" \
    bash -lc "
      set -euo pipefail
      tar --owner=0 --group=0 --numeric-owner -C '$out_dir' -cf '$tar_file' bin share
      gzip -c '$tar_file' >'$base.tgz'
      chown '$UID_NUM:$GID_NUM' '$tar_file' '$base.tgz'
    "

  status "Creating $base.tar.zst"
  zstd -9 -T0 -q "$tar_file" -o "$base.tar.zst"
  rm -f "$tar_file"
}

_checksums() {
  if [[ "$#" -eq 0 ]]; then
    printf 'no Linux archives provided for checksum generation\n' >&2
    exit 1
  fi

  status "Writing checksums"
  (
    cd "$DIST_DIR"
    rm -f bb-linux-SHA256SUMS
    if command -v sha256sum >/dev/null 2>&1; then
      sha256sum "$@" >bb-linux-SHA256SUMS
    else
      shasum -a 256 "$@" >bb-linux-SHA256SUMS
    fi
  )
}

_archive() {
  require_tool "$DOCKER"
  require_tool tar
  require_tool zstd
  local archive_files=()
  for requested in $ARCHS; do
    local arch
    arch="$(normalize_arch "$requested")"
    _archive_arch "$arch"
    archive_files+=("bb-linux-$arch.tar.zst" "bb-linux-$arch.tgz")
  done
  _checksums "${archive_files[@]}"
}

_package() {
  _build
  _archive
}

if [[ "$#" -eq 0 ]]; then
  _package
  exit 0
fi

for cmd in "$@"; do
  case "$cmd" in
    build) _build ;;
    archive) _archive ;;
    package) _package ;;
    *) usage ;;
  esac
done
