#!/usr/bin/env bash
set -euo pipefail

# Only package artifacts for the build-macos step.
[[ "${BUILDKITE_STEP_KEY:-}" == "build-macos" ]] || exit 0

APP_DIR="release/macos/Goose.app"
[[ -d "$APP_DIR" ]] || { echo "No signed app at $APP_DIR" >&2; exit 1; }

echo "~~~ :package: Creating Goose.app.zip and Goose.dmg from signed app"
ditto -c -k --keepParent "$APP_DIR" "release/macos/Goose.app.zip"
hdiutil create -volname "Goose" -srcfolder "$APP_DIR" -ov -format UDZO "release/macos/Goose.dmg"

echo "~~~ :buildkite: Uploading packaged artifacts"
buildkite-agent artifact upload "release/macos/Goose.app.zip"
buildkite-agent artifact upload "release/macos/Goose.dmg"
