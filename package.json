{
  "name": "berd",
  "private": true,
  "version": "0.6.0-rc.2",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "vite",
    "design-system:audit": "node ./scripts/design-system-audit.mjs",
    "design-system:check": "pnpm design-system:manifest-check && pnpm design-system:tokens && pnpm design-system:audit && pnpm design-system:coverage -- --strict",
    "design-system:coverage": "node ./scripts/design-system-coverage.mjs",
    "design-system:generate": "node ./scripts/design-system-manifest.mjs",
    "design-system:manifest-check": "node ./scripts/design-system-manifest.mjs --check",
    "generate:berdctl-contract": "node ./scripts/generate-berdctl-contract.mjs",
    "design-system:tokens": "node ./scripts/design-system-tokens.mjs",
    "build": "tsc && vite build",
    "typecheck": "pnpm --filter @aaif/goose-sdk build:ts && tsc --noEmit",
    "avatars:manifest": "node ./scripts/avatar-manifest.mjs manifest",
    "avatars:publish": "node ./scripts/avatar-manifest.mjs publish",
    "avatars:promote": "node ./scripts/avatar-manifest.mjs promote",
    "artifacts:manifest": "node ./scripts/artifacts-manifest.mjs manifest",
    "artifacts:publish": "node ./scripts/artifacts-manifest.mjs publish",
    "artifacts:promote": "node ./scripts/artifacts-manifest.mjs promote",
    "check:i18n": "node ./scripts/check-i18n-strings.mjs",
    "lint": "biome lint .",
    "check": "biome check . && pnpm check:i18n",
    "format": "biome format --write .",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:release-scripts": "vitest run --config vitest.release-scripts.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm build && playwright test",
    "test:e2e:smoke": "pnpm build && playwright test --project=smoke",
    "test:e2e:personas": "pnpm build && playwright test --project=personas",
    "test:e2e:skills": "pnpm build && playwright test --project=skills",
    "test:e2e:drafts": "pnpm build && playwright test --project=drafts",
    "test:transcript-virtualization:local": "playwright test --config tests/transcript-virtualization/playwright.config.ts",
    "test:transcript-virtualization:real": "TRANSCRIPT_VIRTUALIZATION_START_SERVER=1 TRANSCRIPT_VIRTUALIZATION_RENDERER_URL=http://127.0.0.1:1520/tests/transcript-virtualization/real-renderer-bridge.html TRANSCRIPT_VIRTUALIZATION_RENDERERS=virtual playwright test --config tests/transcript-virtualization/playwright.config.ts --project=desktop tests/transcript-virtualization/transcript-parity.spec.ts tests/transcript-virtualization/transcript-resize-anchoring.spec.ts",
    "test:transcript-virtualization:ci": "TRANSCRIPT_VIRTUALIZATION_START_SERVER=1 TRANSCRIPT_VIRTUALIZATION_RENDERER_URL=http://127.0.0.1:1520/tests/transcript-virtualization/real-renderer-bridge.html TRANSCRIPT_VIRTUALIZATION_RENDERERS=virtual playwright test --config tests/transcript-virtualization/playwright.config.ts --project=desktop tests/transcript-virtualization/transcript-parity.spec.ts tests/transcript-virtualization/transcript-resize-anchoring.spec.ts tests/transcript-virtualization/transcript-product-contract.spec.ts",
    "test:app-e2e": "vitest run --config vitest.app-e2e.config.ts",
    "test:e2e-contract": "node --test scripts/e2e-run-contract.test.mjs",
    "test-driver": "tsx tests/app-e2e/lib/test-driver-cli.ts",
    "tauri:release:config": "node scripts/release/build-tauri-release-config.mjs",
    "validate:runtime-config": "tsx scripts/validate-runtime-config.ts",
    "validate:bundled-agents": "tsx scripts/validate-bundled-agents.ts"
  },
  "dependencies": {
    "@aaif/goose-sdk": "workspace:*",
    "@agentclientprotocol/sdk": "^0.19.0",
    "@daypicker/react": "^10.0.1",
    "@mcp-ui/client": "7.1.1",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-aspect-ratio": "^1.1.15",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-focus-scope": "1.1.16",
    "@radix-ui/react-hover-card": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-menubar": "^1.1.24",
    "@radix-ui/react-navigation-menu": "^1.2.22",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@radix-ui/react-use-controllable-state": "^1.2.6",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@rive-app/react-webgl2": "^4.31.0",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tabler/icons-react": "^3.46.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-virtual": "^3.14.9",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-deep-link": "^2.4.9",
    "@tauri-apps/plugin-dialog": "~2.7.2",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.11.2",
    "ai": "^7.0.58",
    "ansi-to-react": "^6.2.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "fzf": "^0.5.2",
    "i18next": "^26.3.6",
    "i18next-resources-to-backend": "^1.2.3",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "matter-js": "^0.20.0",
    "media-chrome": "^4.19.2",
    "motion": "^13.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.85.0",
    "react-i18next": "^17.0.11",
    "react-jsx-parser": "^2.4.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.10.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^3.23.0",
    "sonner": "^2.0.8",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "tokenlens": "^1.3.1",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.6",
    "vaul": "^1.1.2",
    "yaml": "2.9.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@asamuzakjp/css-color": "3.2.0",
    "@biomejs/biome": "2.4.9",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/matter-js": "^0.20.2",
    "@types/node": "26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "0.185.4",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.26",
    "react-doctor": "^0.9.11",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.11",
    "typescript": "~5.9.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
