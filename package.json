    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/three": "0.184.1",
    "@vitejs/plugin-react": "^4.6.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.10",
    "react-doctor": "^0.5.6",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "typescript": "~5.9.0",
    "vite": "^7.3.5",
    "vitest": "^4.1.0"
  }
}
